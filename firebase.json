{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.git/**",
      "**/node_modules/**",
      "*.rules",
      "README.md",
      "capacitor.config.json",
      "LPArchive-preview.html",
      "package.json",
      "package-lock.json",
      "**/.github/**",
      "android/**"
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": { "rules": "firestore.rules" },
  "storage": { "rules": "storage.rules" }
}
